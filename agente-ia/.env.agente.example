# =============================================================================
#  .env.agente.local — as seis chaves da Letícia (o Agente de IA)
# =============================================================================
#
#  Copie este arquivo e preencha:
#
#      cp agente-ia/.env.agente.example agente-ia/.env.agente.local
#      npm run agente:secrets
#
#  OPCIONAL: o sistema roda inteiro sem estas chaves. Sem elas, o que não
#            funciona é o atendimento automático no WhatsApp — a equipe atende
#            à mão pela tela Conversas, e o resto (agenda, CRM, pacientes,
#            faturamento) segue normal.
#
#  VIDA ÚTIL: permanente, mas fica parado. O `agente:secrets` SOBE as chaves
#             para os secrets do Supabase, e é de lá que a Edge Function lê.
#             O arquivo local vira o seu único registro do que foi configurado
#             — os secrets do Supabase não podem ser lidos de volta. Guarde,
#             e volte nele quando uma chave for trocada.
#
#  ⚠️  NUNCA ponha estas chaves no `.env` da raiz. Aquele arquivo vira
#      JavaScript no navegador, e a sua chave da OpenAI ficaria pública — para
#      qualquer visitante gastar. Estas aqui só existem no servidor.
#
#  ⚠️  Este arquivo (`.env.agente.local`) está no `.gitignore`. O `.example`
#      que você está lendo é que é versionado. Não troque os nomes.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  Os modelos de IA
# -----------------------------------------------------------------------------

# console.anthropic.com -> API Keys
# Só é usada quando o modelo escolhido na tela é um Claude.
ANTHROPIC_API_KEY=

# platform.openai.com -> API Keys
# Usada em DOIS lugares: os modelos GPT e a transcrição dos áudios.
# ⚠️  A transcrição vale mesmo com o Claude escolhido — o paciente brasileiro
#     manda áudio, e sem esta chave a agente trava na primeira mensagem.
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
#  A ponte com o WhatsApp (Evolution API v2)
# -----------------------------------------------------------------------------
#  É o único pedaço do sistema que precisa de servidor próprio (~R$ 40/mês).
#  Os três valores aparecem na tela "Conexão do WhatsApp", em Secretária de IA,
#  para quando o WhatsApp cair e alguém precisar saber em qual painel olhar.

# Endereço do servidor onde a Evolution roda. Sem barra no fim.
# Formato: https://sua-evolution.exemplo.com
EVOLUTION_API_URL=

# A chave de autenticação da sua instalação da Evolution.
# Na tela, só os 4 últimos caracteres aparecem — o suficiente para conferir se
# é a chave que você pensa que é, sem servir para usar.
EVOLUTION_API_KEY=

# O nome da instância que corresponde ao número da clínica.
# É o nome que você deu ao criar a instância na Evolution.
EVOLUTION_INSTANCIA=


# -----------------------------------------------------------------------------
#  A SEGUNDA ponte: uazapi
# -----------------------------------------------------------------------------
#  Preencher aqui NÃO troca o provedor. Quem troca é o seletor na tela
#  Secretária de IA -> Conexão do WhatsApp, que grava a coluna
#  `provedor_whatsapp` (migração 0017). Uma ponte por vez, nunca as duas.
#
#  Deixe em branco se você usa a Evolution. Os dois blocos podem conviver
#  preenchidos — o que decide é a coluna, não a presença da chave.

# Host da API, sem barra no fim.
#   Produção: https://api.uazapi.com     Teste: https://free.uazapi.dev
UAZAPI_API_URL=

# O token DA INSTÂNCIA — o da sua conexão do WhatsApp.
# É o que o sistema usa no dia a dia: enviar, presença, status e mídia.
UAZAPI_TOKEN=

# O token ADMIN da conta — cria e apaga instâncias.
#
# ⚠️  Só preencha se alguma coisa realmente precisar dele. Este sistema nunca
#     cria instância: ele conecta a que já existe, e para isso o token da
#     instância basta. Chave que sobe para as secrets sem ser usada é raio de
#     estrago de graça.
UAZAPI_ADMIN_TOKEN=

# O número conectado NÃO vai aqui, de propósito: `estadoDaConexao()` já devolve
# ele lendo a API, e é assim que a tela mostra. Guardar seria uma segunda
# verdade — que desatualiza calada no dia em que alguém parear outro número.


# -----------------------------------------------------------------------------
#  A tranca do webhook
# -----------------------------------------------------------------------------

# Você inventa este valor. Uma frase longa e aleatória serve.
#
# A função `whatsapp` é publicada com `--no-verify-jwt` de propósito: quem chama
# o webhook é a Evolution, que não tem sessão do Supabase. Então a autenticação
# é ESTE segredo, conferido dentro da função. Sem ele, quem descobrir o endereço
# faz a agente responder por sua conta.
#
# O mesmo valor vai no cabeçalho do webhook, ao apontar a Evolution para a
# função — o passo a passo está na seção 10.5 do README desta pasta.
WEBHOOK_SEGREDO=


# -----------------------------------------------------------------------------
#  O que NÃO vai aqui
# -----------------------------------------------------------------------------
#  SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY não precisam ser configuradas: o
#  Supabase já entrega as duas às Edge Functions sozinho.
